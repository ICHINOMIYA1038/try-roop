rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ----- ヘルパー -----
    // admin custom claim を持つユーザー (tool/setAdminClaim.js で付与) は
    // 管理画面 (site/app/admin) からあらゆるコレクションを操作できる。
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if (request.auth != null && request.auth.uid == userId)
        || isAdmin();
    }

    // User stats
    match /userStats/{userId} {
      allow read: if request.auth != null;
      allow write: if (request.auth != null && request.auth.uid == userId)
        || isAdmin();
    }

    // Videos (public read / admin can write)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories (public read / admin can write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses (public read / admin can write)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Text lessons (public read / admin can write)
    match /textLessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookmarks — docId 形式 `{uid}_{type}_{targetId}` で uid を識別。
    // 存在しないドキュメントの read で permission-denied にならないよう docId プレフィクスで判定。
    match /bookmarks/{bookmarkId} {
      allow read: if isAdmin() || (
        request.auth != null
        && bookmarkId.matches('^' + request.auth.uid + '_.*')
      );
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && bookmarkId.matches('^' + request.auth.uid + '_.*');
      allow delete: if isAdmin() || (
        request.auth != null
        && bookmarkId.matches('^' + request.auth.uid + '_.*')
      );
      allow update: if false;
    }

    // Notifications: 作成は Cloud Functions 等のサーバー側 (admin) を想定。
    // クライアントは自分宛の既読更新のみ許可。
    match /notifications/{notificationId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId)
        || isAdmin();
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow create, delete: if isAdmin();
    }

    // Announcements (public read / admin can write)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Badges (public read / admin can write)
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live schedules (public read / admin can write)
    match /liveSchedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global app config (public read / admin can write)
    // e.g. config/premium_unlock = { enabled: bool, until: timestamp }
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chapters (public read / admin can write)
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Events (public read / admin can write)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-user progress (legacy `progress` and `courseProgress`)
    match /progress/{progressId} {
      allow read, write: if (request.auth != null
        && request.resource.data.userId == request.auth.uid)
        || (request.auth != null && resource != null
        && resource.data.userId == request.auth.uid)
        || isAdmin();
    }

    // docId 形式 `{uid}_{courseId}` で uid を識別。
    // 未作成 (resource == null) のドキュメントも、自分のものなら read 可能にする。
    match /courseProgress/{progressId} {
      allow read: if isAdmin() || (
        request.auth != null
        && progressId.matches('^' + request.auth.uid + '_.*')
      );
      allow write: if isAdmin() || (
        request.auth != null
        && progressId.matches('^' + request.auth.uid + '_.*')
        && request.resource.data.userId == request.auth.uid
      );
    }

    // Event participations — docId 形式 `{uid}_{eventId}`。
    match /eventParticipations/{participationId} {
      allow read: if isAdmin() || (
        request.auth != null
        && participationId.matches('^' + request.auth.uid + '_.*')
      );
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && participationId.matches('^' + request.auth.uid + '_.*');
      allow update, delete: if isAdmin() || (
        request.auth != null
        && participationId.matches('^' + request.auth.uid + '_.*')
      );
    }
  }
}
