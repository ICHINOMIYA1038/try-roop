---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '空手・筋トレ・健康・AIを自分のペースで学べるモバイル学習コミュニティアプリ' } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title} | TryRoop Campus</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta property="og:title" content={`${title} | TryRoop Campus`}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://try-roop.com/images/ogp.jpg">
  <meta property="og:type" content="website">
  <meta property="og:url" content={`https://try-roop.com${Astro.url.pathname}`}>
  <meta property="og:site_name" content="TryRoop Campus">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${title} | TryRoop Campus`}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://try-roop.com/images/ogp.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&family=Klee+One:wght@400;600&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --brand: #e8834a;
      --brand-light: #fdf0e8;
      --brand-dark: #c96a32;
      --accent: #5b9a8b;
      --accent-light: #e8f4f0;
      --bg: #faf8f5;
      --bg-warm: #f5efe8;
      --text: #3d3632;
      --text-muted: #8a7e77;
      --card: #ffffff;
      --border: rgba(61,54,50,0.07);
      --shadow: 0 2px 20px rgba(61,54,50,0.06);
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{
      font-family:'Zen Maru Gothic','Hiragino Maru Gothic ProN',system-ui,sans-serif;
      background:var(--bg);
      color:var(--text);
      line-height:1.9;
      -webkit-font-smoothing:antialiased;
    }
    a{color:inherit;text-decoration:none}
    .container{max-width:1060px;margin:0 auto;padding:0 28px}

    /* Header */
    .header{
      position:sticky;top:0;z-index:50;
      background:rgba(250,248,245,0.9);
      backdrop-filter:blur(16px);
      border-bottom:1px solid var(--border);
    }
    .header-inner{display:flex;align-items:center;justify-content:space-between;height:60px}
    .logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:0.9rem;letter-spacing:0.02em}
    .logo-mark{
      width:32px;height:32px;
      border-radius:8px;
      overflow:hidden;
      transform:rotate(-2deg);
      box-shadow:0 2px 8px rgba(232,131,74,0.2);
    }
    .logo-mark img{width:100%;height:100%;object-fit:cover}
    .nav{display:flex;gap:20px;font-size:0.8125rem;color:var(--text-muted)}
    .nav a{padding:4px 0;position:relative;transition:color 0.2s}
    .nav a:hover{color:var(--text)}
    .nav a::after{
      content:'';position:absolute;bottom:0;left:0;right:0;
      height:2px;background:var(--brand);border-radius:1px;
      transform:scaleX(0);transition:transform 0.25s;
    }
    .nav a:hover::after{transform:scaleX(1)}

    /* Footer */
    .footer{
      background:var(--bg-warm);
      padding:48px 28px 32px;
      text-align:center;
      font-size:0.8rem;
      color:var(--text-muted);
    }
    .footer-inner{max-width:480px;margin:0 auto}
    .footer-links{display:flex;gap:20px;justify-content:center;margin-bottom:20px;font-size:0.8125rem}
    .footer-links a:hover{color:var(--brand)}
    .footer-copy{font-size:0.75rem}

    /* Wavy divider */
    .wave{width:100%;overflow:hidden;line-height:0}
    .wave svg{display:block;width:100%;height:40px}
    .wave-flip{transform:scaleY(-1)}
  </style>
</head>
<body>
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <span class="logo-mark"><img src="/images/icon-sm.jpg" alt="T" width="32" height="32"></span>
        TryRoop
      </a>
      <nav class="nav">
        <a href="/blog">ブログ</a>
        <a href="/privacy">プライバシー</a>
        <a href="/terms">利用規約</a>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-links">
        <a href="/blog">ブログ</a>
        <a href="/privacy">プライバシーポリシー</a>
        <a href="/terms">利用規約</a>
        <a href="mailto:support@try-roop.com">お問い合わせ</a>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} TryRoop &mdash; 学びを、自分のペースで。</p>
    </div>
  </footer>
</body>
</html>
