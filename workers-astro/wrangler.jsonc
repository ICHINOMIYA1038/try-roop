{
	"compatibility_date": "2026-05-03",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "try-roop-web",
	"routes": [
		{ "pattern": "try-roop.com/*", "zone_name": "try-roop.com" },
		{ "pattern": "www.try-roop.com/*", "zone_name": "try-roop.com" }
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}