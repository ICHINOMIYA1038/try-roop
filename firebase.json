{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "site/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**/*.@(js|css|woff|woff2|png|jpg|jpeg|gif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          }
        ]
      }
    ],
    "predeploy": [
      "npm --prefix site ci",
      "npm --prefix site run build"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "try-roop",
          "appId": "1:831378661778:android:1cb6595887cbb3dc4fa14b",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "try-roop",
          "appId": "1:831378661778:ios:2789cfdd90fdf59c4fa14b",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "try-roop",
          "configurations": {
            "android": "1:831378661778:android:1cb6595887cbb3dc4fa14b",
            "ios": "1:831378661778:ios:2789cfdd90fdf59c4fa14b",
            "web": "1:831378661778:web:bdbbaae510e15b474fa14b"
          }
        }
      }
    }
  }
}
